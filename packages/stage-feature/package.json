    "verify": "vitest run --passWithNoTests --no-cache"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@test-platform/contracts": "workspace:*",
    "pinyin-pro": "^3.27.0",
    "yaml": "^2.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
