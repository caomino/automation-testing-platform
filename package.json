{
  "name": "test-platform",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "type": "module",
  "description": "商业自动化测试平台 · monorepo（contracts 先行，stage 解耦）",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter=!app build",
    "build:frontend": "pnpm --filter @test-platform/app build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "verify": "pnpm -r verify",
    "coverage": "pnpm -r coverage",
    "madge": "madge --circular --extensions ts packages/*/src",
    "clean": "pnpm -r exec rm -rf dist",
    "server": "pnpm --filter @test-platform/orchestrator server",
    "restart": "node scripts/restart.mjs restart",
    "restart:build": "node scripts/restart.mjs build",
    "restart:stop": "node scripts/restart.mjs stop",
    "restart:status": "node scripts/restart.mjs status"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "madge": "^8.0.0",
    "playwright": "^1.49.0",
    "prettier": "^3.4.2",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
